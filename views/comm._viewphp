	 	$dis_str.='<div class="breadcrumb">';
        $checkcurrent_status = $data['current_status'];
        if($checkcurrent_status == ST_INACTIVE || $checkcurrent_status== ST_DRAFT ){
            $checkcurrent_status =-1;
        }
        $wlcount = count((array)$wlist);$cw=1;$ork=0;
        foreach ($wlist as $pwlist) {
	        $orcolor =""; $oricon="";
	        if($checkcurrent_status >=$pwlist['status']){    
	          $orcolor = "text-success";
	          $oricon = '<i class="far fa-check-circle text-success"></i> &nbsp;';
	        }else{
	            if($ork==0){
	                $orcolor = "text-primary";
	                $oricon = '<i class="far fa-hourglass text-primary"></i> &nbsp;';
	                $ork =1;
	            }
	        }
		    $dis_str.='<a href="#"><span class="breadcrumb__inner"><span class="breadcrumb__title '.$orcolor.'">';         
			$dis_str.=$oricon.$pwlist['action_label'];
		    $dis_str.='</span> </span></a>';
		    $cw+1;
		} 
		$dis_str.='</div>';
  	} 
  	return $dis_str;
 }
 function todisplaythree($data){
     $diss="";
    if($data['id']!=""){
        if($data['encode']=='no'){
            $data['value_id'] = $data['id'];
        	$data['transaction_number'] = $data['id'];
        	$data['transaction_id'] = $data['id'];
        }else{
        $rid =  encodeId($data['id']);
    	$rid = urldecode($rid);
     	$erid = explode(':', $rid);
     	$data['value_id'] = $erid[1];
     	$data['transaction_number'] = $erid[1];
     	$data['transaction_id'] = $erid[1];
        }
     	echo '<div class="col-lg-12 mt-2"><div class="card card-custom"> <div class="card-body"><div class="col-lg-12">';
     	if($data['dis_query']=='yes'){	$diss.= todisplayquerylist($data); }
     	if($data['dis_timeline']=='yes'){ $diss.= todisplaytimeline($data); }
        if($data['dis_comments']=='yes'){	$diss.= todiplaycomments($data); }
     	$diss.='</div></div></div></div>';
    }
 	return $diss;
 }
 function todisplayquerylist($data){
    //print_r($data); exit;
 	$question_display ='Y';
    $replay_display = 'N';
    $trnsation_no = $data['transaction_number'];
    if($_SESSION['userid'] == $data['originator']){
        $question_display ='N';
        $replay_display = 'Y';
    }
    $dis_str ='';
   include_once("views/custom_query.php");  
  
    
 }
 function todisplaytimeline($data){
   // print_r($data);
   
 	$vdata1["where"] = array('transaction_primary_1'=> $data['value_id'],'transaction_table'=>$data['table']);
    $vdata1["field"] = "id,transaction_type,user_id,action_log,action_date,status_value";
    $vdata1['order'] = "id DESC";
    $vdata = urlencode(json_encode($vdata1));
    $vurl = API."?mode=gettabledetailswithconditions&table=".TBL_ACTION_LOG."&data=".$vdata; 
    $vdata_details = callAPI($vurl);
    $vdata_details = json_decode($vdata_details,1);
    //print_r($vdata1);
    $dis_str ='';
    //$dis_str.='<div class="col-lg-12">';
    $dis_str.='<div class="accordion accordion-solid mt-2 accordion-toggle-arrow" id="accordionExample2">                    
                    <div class="card">
                        <div class="card-header" id="headingTwo2">
                            <div class="card-title collapsed" data-toggle="collapse" data-target="#collapseTwo2" aria-expanded="false" aria-controls="collapseTwo2">
                                Transaction Timeline
                            </div>
                        </div>
                        <div id="collapseTwo2" class="collapse" aria-labelledby="headingTwo2" data-parent="#accordionExample2">
                            <div class="card-body">
                                    <div class="kt-timeline-v2 ml-10">
                                        <div class="kt-timeline-v2__items  kt-padding-top-25 kt-padding-bottom-30">';
                                            foreach ($vdata_details as  $vdvalue) { 
                                $dis_str.=' <div class="kt-timeline-v2__item mt-5">
                                                <div class="kt-timeline-v2__item-cricle ml-2 float-left">';
                                                    if($vdvalue['transaction_type'] == 'INSERT'){ 
                                                 $dis_str.='<i class="fa fa-genderless text-success icon-xl"></i>';
                                                    } 
                                                    if($vdvalue['transaction_type'] == 'UPDATE'){ 
                                                  	 $dis_str.='<i class="fa fa-genderless text-warning icon-xl"></i>';
                                                    } 
                                                $dis_str.='</div>
                                                <div class="kt-timeline-v2__item-text  kt-padding-top-5">
                                                    <b>&nbsp;'.date("M d, Y g:i A", strtotime($vdvalue['action_date'])).'</b>'.
                                                    $vdvalue['action_log'].'&nbsp;'.$_SESSION['users'][$vdvalue['user_id']].' with Status '.$_SESSION['status'][$vdvalue['status_value']]['name']; 
                                                    
                                                $dis_str.='</div>
                                            </div>';
                                              } 
                                       $dis_str.=' </div>
                                    </div>
                            </div>
                        </div>
                    </div>
                </div> ';
    return $dis_str;
 }
 function todiplaycomments($data){
 
	$appruser_list_data = togetaprovaluserlist($data['table'], $data['value_id']);
	$appruser_list = $appruser_list_data['user'];
	$appruser_data =  $appruser_list_data['details'];
    	$dis_str ='';
    //	print_r($appruser_data);
	if(count((array)$appruser_data) > 0){
	$stausresult = ViewStatusData();

	$dis_str.='<div>  
	    <div class="accordion accordion-solid mt-2 accordion-toggle-arrow" id="accordionExample2">
	        <div class="card">
	            <div class="card-header" id="headingTwo21">
	                <div class="card-title collapsed" data-toggle="collapse" data-target="#collapseTwo21" aria-expanded="false" aria-controls="collapseTwo21">
	                    Comments
	                </div>
	            </div>
	            <div id="collapseTwo21" class="collapse" aria-labelledby="headingTwo21" data-parent="#accordionExample2">
	                <div class="card-body">
	                    <div class="kt-timeline-v2">
	                        <div class="timeline timeline-6 mt-3">';
	                            foreach ($appruser_data as  $lists) { 
	            $dis_str.=' 	 <div class="timeline-item align-items-start">
	                                  <div class="timeline-label font-weight-bolder text-dark-75 font-size-lg"></div>
	                                <div class="timeline-badge">';
	                                    if($lists['response_type'] == '3'){ 
	                      $dis_str.='   <i class="fa fa-genderless text-success icon-xl"></i>';
	                                   } else{ 
	                      $dis_str.='  <i class="fa fa-genderless text-warning icon-xl"></i>';
	                                    } 
	                     $dis_str.='</div>
	                                <div class="timeline-content d-flex">';
	                                  	if($lists['response_type'] == 0){ $list_date = $lists['request_date']; }else{  $list_date = $lists['response_date']; }
	                  $dis_str.='      <b> '. date("M d, Y g:i A", strtotime($list_date)).'</b> &nbsp;'.
	                                    $_SESSION['users'][$lists['user_id']].'&nbsp; with Status &nbsp;<span style="color:#'.$stausresult[$lists['response_type']]['color'].' background:#'.strval($stausresult[$lists['response_type']]['background_color']).'class="label label-lg label-light-primary label-inline font-weight-bold py-4">';
	                                    if($lists['response_type'] == 0){ $dis_str.='Yet to respond'; }else{ $dis_str.=$stausresult[$lists['response_type']]['name']; }
	                                    $dis_str.='</span> &nbsp;'.$lists['comments'].'
	                                </div>
	                            </div>';
	                            } 
	                       $dis_str.='</div>
	                    </div>
	                </div>
	            </div>
	        </div>
	    </div>
	</div>';
	} 
 	return $dis_str;
 }
