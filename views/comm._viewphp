function toGetTableNameBaseApplicationPagesList($type, $type_name, $case=''){
	//echo "asdlaslda";
	if($case == ''){
	$type_name = strtoupper($type_name);
	}
	foreach ($_SESSION['application_pages'] as $page){
		if($page[$type] == $type_name){
			$data = $page; 
			break;
		}	
	}
	//print_r($data);
	return $data;
}
