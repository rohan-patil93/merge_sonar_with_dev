function imageupload($jnt,$imagename,$hidimage,$exname=""){
	$name = $hidimage;
	echo "Ravi".$imagename.$array_number; print_r($_FILES); exit;
	$exname = ($exname =="") ? "file" : $exname;
	if($_FILES[$imagename]['name']!=""){
		$ext=explode(".",$_FILES[$imagename]['name']);
		$name= $exname.'_'.time()."_".uniqid().'.'.$ext[1];
		$path = 'hrstaq/demo/uploads/'.$jnt.'/';
		echo $path.$name; //exit;
		if(!is_dir($path)) { 	
			echo "dir";	
			$dual_path = trim($path,'/');
			$dual_path = explode('/', $dual_path);
			$epath ="";
			foreach ($dual_path as $dpath) {
				$epath = $epath.$dpath."/";
				if(!is_dir($epath)){
					//echo "<br>no dir".$epath;
					$ss = mkdir($epath); 
					echo $ss;
				}else{
					//echo "<br>yes dir".$epath;
				}
			}
			
		}
		$res = move_uploaded_file($_FILES[$imagename]['tmp_name'],$path.$name);
		//echo $res; exit;
	} 
	return $name;
}
function imageuploadwitharray($jnt,$imagename,$hidimage,$exname="",$array_number=''){	
	
	$name = $hidimage;	
	$exname = ($exname =="") ? "file" : $exname;
	
	if($_FILES[$imagename]['name'][$array_number]!=""){	
	    //echo "man";
		$ext=explode(".",$_FILES[$imagename]['name'][$array_number]);	
		$name= $exname.'_'.time()."_".uniqid().'.'.$ext[1];	
		$path = 'hrstaq/demo/uploads/'.$jnt.'/';	
		echo $path.$name; exit;
		if(!is_dir($path)) { 			
			$dual_path = trim($path,'/');	
			$dual_path = explode('/', $dual_path);	
			$epath ="";	
			foreach ($dual_path as $dpath) {	
				$epath = $epath.$dpath."/";	
				if(!is_dir($epath)){	
					mkdir($epath); 	
				}	
			}	
				
		}	
		move_uploaded_file($_FILES[$imagename]['tmp_name'][$array_number],$path.$name);	
	} 	
	return $name;	
}
