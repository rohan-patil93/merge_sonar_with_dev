		    echo "Ravi";//exit;
			$str =''; $sstr ='';
			$str = strtolower(substr($mesg,$mes1,$mes2-$mes1));
			$sstr = "{[".$str."]}";
			$mesg = str_replace($sstr, $data[$str], $mesg);
