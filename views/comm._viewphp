function callAPI($page){
		$url = $page."&data_name=".$_SESSION['DB_NAME']."&user_id=".$_SESSION['userid']."&company_id=".$_SESSION['company_id']."&ipaddress=".$_SERVER['REMOTE_ADDR']."&page_option=".$_GET['option'];
		//echo $url; //exit;
		$res = file_get_contents($url, false, $context);
		//echo $res; //exit;
		//echo "man";
		return $res;
}
